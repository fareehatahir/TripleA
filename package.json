{
  "name": "tripleaint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma.mjs studio",
    "postinstall": "node scripts/prisma.mjs generate",
    "typecheck": "tsc --noEmit",
    "db:seed:catalog": "tsx --env-file=.env prisma/seed-catalog.ts",
    "db:seed:demo": "tsx --env-file=.env prisma/seed-catalog.ts --demo",
    "test:e2e": "npm run build && playwright test",
    "db:deploy": "node scripts/prisma.mjs deploy",
    "db:pg:sync": "node scripts/pg-sync.mjs",
    "db:pg:baseline": "node scripts/pg-sync.mjs --baseline",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.6.0",
    "jszip": "^3.10.2",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "papaparse": "^5.7.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}