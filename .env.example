# --- Site ---
NEXT_PUBLIC_SITE_URL=https://tripleaint.tw
# WhatsApp number, digits only, international format (no + or spaces)
NEXT_PUBLIC_WHATSAPP=886900000000

# --- Database --- (SQLite for dev; Postgres URL in production, see prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/tripleaint?schema=public"

# Neon (written by `neon deploy`): DATABASE_URL is the pooled URL used by the app, DATABASE_URL_UNPOOLED is used for migrations.
# DATABASE_URL_UNPOOLED=
# Neon Object Storage: set S3_BUCKET to the bucket in neon.ts; AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_REGION are used automatically.
# Vercel reserves AWS_* names, so there copy the same values into S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and S3_REGION.

# --- Auth.js --- generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Seed: first super admin (change the password after first login) ---
ADMIN_EMAIL=admin@tripleaint.tw
ADMIN_PASSWORD=
ADMIN_NAME="Site Owner"

# --- Email (optional until Stage 4; without SMTP, emails are printed to the server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Triple A International <info@tripleaint.tw>"

# --- Uploads --- local disk by default (served through /uploads/*)
UPLOAD_DIR=./storage/uploads
# Optional S3-compatible storage (Cloudflare R2 / AWS S3). When S3_BUCKET is set, it is used instead of local disk.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=            # R2: https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=          # public base URL of the bucket / CDN, e.g. https://media.tripleaint.tw
# Stamp the logo on product photos (true/false)
WATERMARK=false

# Who receives new-inquiry emails (comma separated). Can be overridden later in Admin > Settings.
INQUIRY_NOTIFY_TO=info@tripleaint.tw

# --- Optional spam protection (Cloudflare Turnstile). Leave blank to rely on honeypot + rate limiting. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Docker Compose (REQUIRED when using docker-compose.yml) ---
POSTGRES_USER=tripleaint
POSTGRES_PASSWORD=
POSTGRES_DB=tripleaint
# First boot only: set to false to skip the sample products and gallery photos
# SEED_CATALOG=true
