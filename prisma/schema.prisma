// Local dev uses SQLite. For production Postgres: change `provider` to "postgresql",
// set DATABASE_URL to your Postgres URL, delete prisma/migrations and run `npx prisma migrate dev --name init`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SOLD
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum Fuel {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  AT
  MT
  CVT
}

enum Drive {
  TWO_WD
  FOUR_WD
}

enum Condition {
  USED
  REBUILT
  NEW
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  totpBackupCodes String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resetTokens PasswordResetToken[]
  auditLogs   AuditLog[]
  media       MediaAsset[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  image    String?
  order    Int        @default(0)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([order])
}

model Make {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  logo     String?
  order    Int        @default(0)
  models   CarModel[]
  products Product[]

  @@index([order])
}

// "Model" is awkward as a Prisma model name, so it is CarModel.
model CarModel {
  id       String    @id @default(cuid())
  name     String
  slug     String
  order    Int       @default(0)
  makeId   String
  make     Make      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([makeId, slug])
  @@index([makeId])
}

model Product {
  id             String        @id @default(cuid())
  sku            String        @unique
  slug           String        @unique
  title          String
  description    String?
  included       String?
  categoryId     String
  makeId         String?
  modelId        String?
  yearFrom       Int?
  yearTo         Int?
  engineCode     String?
  displacement   Int?
  fuel           Fuel?
  transmission   Transmission?
  drive          Drive?
  condition      Condition     @default(USED)
  weightKg       Float?
  mileageKm      Int?
  stock          Int           @default(1)
  price          Float?
  showPrice      Boolean       @default(false)
  currency       String        @default("USD")
  featured       Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  videoUrl       String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category Category      @relation(fields: [categoryId], references: [id])
  make     Make?         @relation(fields: [makeId], references: [id])
  model    CarModel?     @relation(fields: [modelId], references: [id])
  images   ProductImage[]
  specs    ProductSpec[]
  inquiryItems InquiryItem[]

  @@index([categoryId])
  @@index([makeId])
  @@index([status])
  @@index([createdAt])
  @@index([engineCode])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  thumbUrl  String?
  blur      String?
  alt       String?
  order     Int     @default(0)
  isCover   Boolean @default(false)
  mediaId   String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([mediaId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  key       String
  value     String
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inquiry {
  id        String        @id @default(cuid())
  reference String        @unique
  name      String
  company   String?
  country   String
  phone     String
  email     String
  port      String?
  message   String?
  status    InquiryStatus @default(NEW)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     InquiryItem[]
  replies   InquiryReply[]

  @@index([status])
  @@index([createdAt])
}

model InquiryItem {
  id        String   @id @default(cuid())
  inquiryId String
  productId String?
  title     String
  sku       String
  qty       Int      @default(1)
  note      String?
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
}

model InquiryReply {
  id        String   @id @default(cuid())
  inquiryId String
  subject   String
  body      String
  sentBy    String
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

/// Privacy-friendly analytics: one counter per path per day. No cookies, no IPs, no visitor IDs.
model PageView {
  id    String @id @default(cuid())
  day   String
  path  String
  count Int    @default(0)

  @@unique([day, path])
  @@index([day])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ShippingRate {
  id            String   @id @default(cuid())
  departure     String   @default("Taiwan")
  country       String
  port          String
  containerType String   @default("40HQ")
  freightUsd    Float
  validUntil    DateTime
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([validUntil])
}

model LoadingPhoto {
  id          String   @id @default(cuid())
  url         String
  thumbUrl    String?
  caption     String?
  destination String?
  shotAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([shotAt])
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  content        String
  coverUrl       String?
  tags           Json          @default("[]")
  status         ProductStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String?
  quote     String
  avatarUrl String?
  order     Int     @default(0)
  active    Boolean @default(true)
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  group    String  @default("general")
  order    Int     @default(0)
  active   Boolean @default(true)
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ContentBlock {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  thumbUrl     String?
  blur         String?
  hash         String?
  filename     String
  mime         String
  size         Int
  width        Int?
  height       Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([hash])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  action    String
  entity    String
  entityId  String?
  summary   String
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}
